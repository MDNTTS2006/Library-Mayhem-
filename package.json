{
  "name": "library-mayhem",
  "version": "1.0.0",
  "description": "A fast-paced top-down library management game where players return books, help students by answering quiz questions, and keep the library under control before time runs out.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:create": "sequelize-cli db:create",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:status": "sequelize-cli db:migrate:status",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:seed": "sequelize-cli db:seed:all",
    "db:seed:undo": "sequelize-cli db:seed:undo:all",
    "db:reset": "node scripts/db-wipe.js && sequelize-cli db:migrate && sequelize-cli db:seed:all",
    "db:check": "node scripts/db-check.js",
    "check": "node scripts/ci-check.js"
  },
  "engines": {
    "node": ">=22"
  },
  "author": "Angelo A. Lapizar",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^16.0.0",
    "express": "^4.18.0",
    "pg": "^8.11.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.0"
  },
  "devDependencies": {
    "sequelize-cli": "^6.6.0"
  }
}
